@model IReadOnlyList<RootObject>

@{
    ViewData["Title"] = "Home users";
}

<section class="container mt-5 pt-5 mb-5 justify-content-between">
    @if (ViewData["ApiError"] is string apiError)
    {
        <div class="alert alert-warning" role="alert">@apiError</div>
    }
    <h4>API endpoint results <span class="badge badge-secondary">@Model.Count users</span></h4>
    @if (Model.Count == 0 && ViewData["ApiError"] is null)
    {
        <p class="text-muted">No users are available. The API may have started without sample data.</p>
    }
    <div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-sm">
        <caption>List of users</caption>
        <thead class="thead-dark">
            <tr class="text-center">
                <th scope="col">Username</th>
                <th scope="col">Name</th>
                <th scope="col">Gender</th>
                <th scope="col">Birth date</th>
                <th scope="col">Age</th>
                <th scope="col">Location</th>
                <th scope="col">Eldest</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr class="@(item.isTheEldest ? "table-success" : "")">
                <td>@item.userName</td>
                <td>@CapitalLetterHelper.FirstCharToUpper(item.name)</td>
                <td>@CapitalLetterHelper.FirstCharToUpper(item.gender)</td>
                <td>@item.birthDate.ToString("yyyy-MM-dd")</td>
                <td>@item.age</td>
                <td>
                    @if (item.location == null)
                    {
                        <span class="text-muted">No data</span>
                    }
                    else
                    {
                        @($"{item.location.street}, {item.location.city}, {item.location.state}")
                    }
                </td>
                <td>@(item.isTheEldest ? "Yes" : "No")</td>
            </tr>
            }

        </tbody>
    </table>
    </div>
</section>
